# TechSpar 启动配置 —— 主要放「引导项」。
#
# LLM / Embedding / DashScope / Tavily / 阿里云 OSS / 腾讯云 VPR 等所有密钥，
# 默认都由每个用户登录后在「设置」里自己填（首次登录有两步引导带你配 LLM + Embedding），
# 互不共享、各算各的账。唯一的例外是文件末尾可选的 PLATFORM_* 兜底配置。

# Auth
JWT_SECRET=change-me-in-production
# 声纹服务凭据在磁盘上的加密密钥；生产环境应与 JWT_SECRET 分开。
VOICEPRINT_ENCRYPTION_KEY=change-me-separately-in-production
DEFAULT_EMAIL=admin@techspar.local
DEFAULT_PASSWORD=admin123
DEFAULT_NAME=Admin
# 是否允许新用户在登录页注册。false 时只有上面的 DEFAULT_EMAIL/PASSWORD 能登录。
# 也可在设置页“账户”标签里切换，运行时即时生效（此文件只用于首次启动的初值）。
ALLOW_REGISTRATION=false

# Server / data paths
HOST=0.0.0.0
PORT=8000
TECHSPAR_BASE_DIR=.
TECHSPAR_DATA_DIR=data
DB_PATH=data/interviews.db
# 本地 Transformers.js/ONNX 模型缓存；留空时使用运行时默认缓存目录。
# TECHSPAR_MODEL_CACHE_DIR=
# 让 Hono 同时托管 Vite 构建产物时填写，例如 frontend/dist。
# TECHSPAR_WEB_DIR=

# ── 平台兜底模型（可选，默认关闭）──
# 全部留空 = 保持默认行为：每个用户必须自己填 key。
#
# 填上之后，没配 key 的用户会自动用这里的配置，成本由部署方承担。两种典型场景：
#   1. 机构/团队部署：管理员配一把 key，成员开箱即用，不用人手一个账号去申请。
#   2. 托管服务：给未付费用户免配 key 的体验入口。
# 已经填了自己 key 的用户不受影响，照走自己的，也不计入下面的额度。
#
# 注意：这是本文件里唯一会出现真实密钥的地方，别把 .env 提交进版本库。
# PLATFORM_LLM_API_BASE=
# PLATFORM_LLM_API_KEY=
# PLATFORM_LLM_MODEL=
# PLATFORM_EMBEDDING_API_BASE=
# PLATFORM_EMBEDDING_API_KEY=
# PLATFORM_EMBEDDING_MODEL=
#
# 平台 key 的每用户每日调用次数上限，0 或不填 = 不限。
# 开着平台 key 却不设上限，等于把自己的额度敞开给全网，务必按实际成本设一个值。
# PLATFORM_DAILY_CALL_LIMIT=0
